<svg width="64" height="64" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Radial gradient for soft particle effect -->
    <radialGradient id="particleGradient" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#4fc3f7;stop-opacity:1" />
      <stop offset="30%" style="stop-color:#4fc3f7;stop-opacity:0.8" />
      <stop offset="60%" style="stop-color:#4fc3f7;stop-opacity:0.4" />
      <stop offset="80%" style="stop-color:#4fc3f7;stop-opacity:0.1" />
      <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0" />
    </radialGradient>
    
    <!-- Inner glow gradient -->
    <radialGradient id="innerGlow" cx="50%" cy="50%" r="25%">
      <stop offset="0%" style="stop-color:#81d4fa;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#4fc3f7;stop-opacity:0.6" />
      <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <!-- Main particle circle -->
  <circle cx="32" cy="32" r="32" fill="url(#particleGradient)" />
  
  <!-- Inner bright core -->
  <circle cx="32" cy="32" r="16" fill="url(#innerGlow)" />
  
  <!-- Sparkle effect -->
  <circle cx="32" cy="32" r="4" fill="#e1f5fe" opacity="0.9" />
</svg>
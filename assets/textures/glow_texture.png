<svg width="128" height="128" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <!-- Outer glow gradient -->
    <radialGradient id="outerGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#4fc3f7;stop-opacity:0.8" />
      <stop offset="20%" style="stop-color:#4fc3f7;stop-opacity:0.6" />
      <stop offset="40%" style="stop-color:#4fc3f7;stop-opacity:0.4" />
      <stop offset="60%" style="stop-color:#4fc3f7;stop-opacity:0.2" />
      <stop offset="80%" style="stop-color:#4fc3f7;stop-opacity:0.1" />
      <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0" />
    </radialGradient>
    
    <!-- Mid glow gradient -->
    <radialGradient id="midGlow" cx="50%" cy="50%" r="35%">
      <stop offset="0%" style="stop-color:#81d4fa;stop-opacity:0.7" />
      <stop offset="30%" style="stop-color:#4fc3f7;stop-opacity:0.5" />
      <stop offset="60%" style="stop-color:#4fc3f7;stop-opacity:0.3" />
      <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0" />
    </radialGradient>
    
    <!-- Inner bright core -->
    <radialGradient id="brightCore" cx="50%" cy="50%" r="20%">
      <stop offset="0%" style="stop-color:#e1f5fe;stop-opacity:0.9" />
      <stop offset="40%" style="stop-color:#81d4fa;stop-opacity:0.7" />
      <stop offset="70%" style="stop-color:#4fc3f7;stop-opacity:0.4" />
      <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0" />
    </radialGradient>
    
    <!-- Subtle ring effect -->
    <radialGradient id="ringEffect" cx="50%" cy="50%" r="45%">
      <stop offset="0%" style="stop-color:#4fc3f7;stop-opacity:0" />
      <stop offset="70%" style="stop-color:#4fc3f7;stop-opacity:0" />
      <stop offset="75%" style="stop-color:#81d4fa;stop-opacity:0.3" />
      <stop offset="80%" style="stop-color:#4fc3f7;stop-opacity:0.2" />
      <stop offset="100%" style="stop-color:#4fc3f7;stop-opacity:0" />
    </radialGradient>
  </defs>
  
  <!-- Outer glow layer -->
  <circle cx="64" cy="64" r="64" fill="url(#outerGlow)" />
  
  <!-- Ring effect -->
  <circle cx="64" cy="64" r="58" fill="url(#ringEffect)" />
  
  <!-- Mid glow layer -->
  <circle cx="64" cy="64" r="44" fill="url(#midGlow)" />
  
  <!-- Inner bright core -->
  <circle cx="64" cy="64" r="25" fill="url(#brightCore)" />
  
  <!-- Central sparkle -->
  <circle cx="64" cy="64" r="6" fill="#ffffff" opacity="0.8" />
  
  <!-- Small accent sparkles -->
  <circle cx="58" cy="58" r="2" fill="#e1f5fe" opacity="0.6" />
  <circle cx="70" cy="58" r="1.5" fill="#e1f5fe" opacity="0.5" />
  <circle cx="58" cy="70" r="1.5" fill="#e1f5fe" opacity="0.5" />
  <circle cx="70" cy="70" r="2" fill="#e1f5fe" opacity="0.6" />
</svg>